# Public repositories work without a token, but authenticated access is strongly recommended.
ADS_GITHUB_TOKEN=
# Comma-separated owner/repo entries. Optional @version hint, e.g. owner/repo@v0.4.
ADS_REPOSITORIES=kaicreator-mm/ai-development-standard
ADS_DATA_DIR=.data
ADS_PORT=4310
ADS_HOST=0.0.0.0
ADS_SYNC_INTERVAL_SECONDS=300
# Set to 1 to load the bundled deterministic demo snapshot instead of GitHub.
ADS_DEMO=0
